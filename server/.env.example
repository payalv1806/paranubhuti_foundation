# Server Port
PORT=5000

# Razorpay API Credentials (Get from https://dashboard.razorpay.com/app/keys)
# For testing: use keys starting with rzp_test_
# For production: use keys starting with rzp_live_
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Allowed Frontend Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://paranubhutifoundation.netlify.app
