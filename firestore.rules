rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Strict validation: Only the authenticated account associated with info@paranubhutifoundation.org
    // has administrative privileges. Adding an email to the recipient list does NOT grant admin access.
    function isAuthorizedAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'info@paranubhutifoundation.org';
    }

    // -------------------------------------------------------------------------
    // Notification Emails Collection
    // -------------------------------------------------------------------------
    // Only the authorized admin can view, add, or remove recipient notification emails.
    // Regular users cannot read or modify this collection.
    match /notification_emails/{emailId} {
      allow read, write, delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Announcements Collection
    // -------------------------------------------------------------------------
    // All authenticated users can read official announcements.
    // Only the authorized admin can publish, update, or delete announcements.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Outgoing Mail Queue Collection (Firebase Trigger Email / Backend)
    // -------------------------------------------------------------------------
    // Only authorized admin can queue announcement notification emails.
    // Disallows client reads/modifications to protect email queues.
    match /mail/{mailId} {
      allow create: if isAuthorizedAdmin();
      allow read, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Birthdays Collection
    // -------------------------------------------------------------------------
    match /birthdays/{birthdayId} {
      allow read, write, delete: if isAuthenticated() && (
        resource == null || resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // Donations Collection
    // -------------------------------------------------------------------------
    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Causes Collection
    // -------------------------------------------------------------------------
    match /causes/{causeId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Fundraisers Collection
    // -------------------------------------------------------------------------
    // Public read so donors and app users can view fundraiser progress and details.
    // Authenticated users can create fundraisers tied to their own account.
    // Fundraiser owners and admins can edit details or delete.
    match /fundraisers/{fundraiserId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAuthorizedAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAuthorizedAdmin()
      );
    }

    // -------------------------------------------------------------------------
    // Certificates Collection
    // -------------------------------------------------------------------------
    // Users can read certificates issued to them; admin can read/manage all.
    // Creation permitted for authenticated users for their own verified donations.
    // Update is strictly disallowed to prevent tampering with donation amount or metadata.
    match /certificates/{certId} {
      allow read: if isAuthenticated() && (
        resource == null || resource.data.userId == request.auth.uid || isAuthorizedAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || isAuthorizedAdmin()
      );
      allow update: if false;
      allow delete: if isAuthorizedAdmin();
    }
  }
}
