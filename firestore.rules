rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Strict validation: Only the authenticated account associated with info@paranubhutifoundation.org
    // has administrative privileges. Adding an email to the recipient list does NOT grant admin access.
    function isAuthorizedAdmin() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.lower() == 'info@paranubhutifoundation.org';
    }

    // -------------------------------------------------------------------------
    // Notification Emails Collection
    // -------------------------------------------------------------------------
    // Only the authorized admin can view, add, or remove recipient notification emails.
    // Regular users cannot read or modify this collection.
    match /notification_emails/{emailId} {
      allow read, write, delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Announcements Collection
    // -------------------------------------------------------------------------
    // All authenticated users can read official announcements.
    // Only the authorized admin can publish, update, or delete announcements.
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Outgoing Mail Queue Collection (Firebase Trigger Email / Backend)
    // -------------------------------------------------------------------------
    // Only authorized admin can queue announcement notification emails.
    // Disallows client reads/modifications to protect email queues.
    match /mail/{mailId} {
      allow create: if isAuthorizedAdmin();
      allow read, update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Users Collection
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------------
    // Birthdays Collection
    // -------------------------------------------------------------------------
    match /birthdays/{birthdayId} {
      allow read, write, delete: if isAuthenticated() && (
        resource == null || resource.data.ownerId == request.auth.uid || request.resource.data.ownerId == request.auth.uid
      );
    }

    // -------------------------------------------------------------------------
    // Donations Collection
    // -------------------------------------------------------------------------
    match /donations/{donationId} {
      allow read: if isAuthenticated() || (resource != null && resource.data.anonymous == true);
      allow create: if isAuthenticated() || (request.resource.data.anonymous == true);
      allow update: if isAuthorizedAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      ) || (
        resource.data.anonymous == true && request.resource.data.paymentStatus in ['completed', 'failed']
      );
      allow delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Causes Collection
    // -------------------------------------------------------------------------
    match /causes/{causeId} {
      allow read: if true;
      // Admin has full write access; donors can atomically increment totalRaised on donations
      allow update: if isAuthorizedAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalRaised'])
      );
      allow create, delete: if isAuthorizedAdmin();
    }

    // -------------------------------------------------------------------------
    // Certificates Collection
    // -------------------------------------------------------------------------
    // Certificates can be viewed by their recipient or verified publicly.
    // Creation permitted for authenticated donors or anonymous gift issuance.
    // Update is strictly disallowed to prevent tampering with donation amount or metadata.
    match /certificates/{certId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAuthorizedAdmin() || (
        request.resource.data.userId == '' || request.resource.data.donorName != null
      );
      allow update: if false;
      allow delete: if isAuthorizedAdmin();
    }
  }
}
